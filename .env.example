# Diabetes Prediction System - Environment Configuration Example
# Copy this file to .env and update with your actual values

# Backend Configuration
PROJECT_NAME=Diabetes Prediction System
VERSION=1.0.0
API_PREFIX=/api

# Security
# Generate a secure random key for production deployment
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# SQLite database path (relative to backend directory)
DATABASE_URL=sqlite:///./diabetes_app.db

# ML Model Paths
MODEL_PATH=../models/diabetes_best_model.joblib
BASELINE_MODEL_PATH=../models/diabetes_svm_baseline.joblib
METADATA_PATH=../models/model_metadata.json
EVAL_RESULTS_DIR=../backend/ml/evaluation_results

# CORS Settings
# Comma-separated list of allowed origins for frontend access
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Configuration
HOST=0.0.0.0
PORT=8000
